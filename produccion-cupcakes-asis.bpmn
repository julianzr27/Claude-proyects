<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_CupcakesAsIs" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_CupcakesAsIs">
    <bpmn:participant id="Pool_Cliente" name="Cliente" />
    <bpmn:participant id="Pool_Produccion" name="Proceso de producción" processRef="Process_ProduccionAsIs" />
    <bpmn:messageFlow id="MF_Pedido" name="Pedido" sourceRef="Pool_Cliente" targetRef="E1" />
    <bpmn:messageFlow id="MF_Entrega" name="Entrega" sourceRef="A15" targetRef="Pool_Cliente" />
    <bpmn:messageFlow id="MF_Reclamo" name="Reclamo" sourceRef="Pool_Cliente" targetRef="E5" />
    <bpmn:messageFlow id="MF_Compensacion" name="Compensación" sourceRef="A18" targetRef="Pool_Cliente" />
  </bpmn:collaboration>
  <bpmn:process id="Process_ProduccionAsIs" name="Producción de cupcakes (AS-IS)" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Asistente" name="Asistente de cocina">
        <bpmn:flowNodeRef>E1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A16</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A17</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Chef" name="Chef">
        <bpmn:flowNodeRef>A4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A15</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A18</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Calidad" name="Departamento de calidad">
        <bpmn:flowNodeRef>U4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A19</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A20</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A21</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E8</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="E1" name="Pedido recibido vía telefónica">
      <bpmn:messageEventDefinition id="MED_E1" />
    </bpmn:startEvent>
    <bpmn:task id="A1" name="Tomar el pedido" />
    <bpmn:task id="A2" name="Lavar el tazón" />
    <bpmn:exclusiveGateway id="G1" name="¿Primer lote del día?" default="F_G1_No" />
    <bpmn:task id="A3" name="Precalentar el horno" />
    <bpmn:exclusiveGateway id="U1" name="" />
    <bpmn:task id="A4" name="Medir, juntar y mezclar ingredientes" />
    <bpmn:exclusiveGateway id="U2" name="" />
    <bpmn:task id="A5" name="Verificar humedad de la masa" />
    <bpmn:exclusiveGateway id="G2" name="¿Humedad correcta?" default="F_G2_No" />
    <bpmn:intermediateCatchEvent id="E2" name="Esperar humedad adecuada">
      <bpmn:timerEventDefinition id="TED_E2" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="A6" name="Colocar la masa en los moldes" />
    <bpmn:exclusiveGateway id="G3" name="¿Tiene toppings especiales?" default="F_G3_No" />
    <bpmn:task id="A7" name="Agregar toppings especiales" />
    <bpmn:exclusiveGateway id="U3" name="" />
    <bpmn:task id="A8" name="Colocar moldes en el horno" />
    <bpmn:task id="A9" name="Fijar termostato y reloj" />
    <bpmn:intermediateCatchEvent id="E3" name="Horneado 12 min">
      <bpmn:timerEventDefinition id="TED_E3">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT12M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="A10" name="Sacar moldes del horno" />
    <bpmn:intermediateCatchEvent id="E4" name="Enfriado 5 min">
      <bpmn:timerEventDefinition id="TED_E4">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT5M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="A11" name="Desmoldar cupcakes" />
    <bpmn:task id="A12" name="Inspeccionar cupcakes" />
    <bpmn:inclusiveGateway id="G4" name="¿Resultado de inspección?" default="F_G4_Conformes" />
    <bpmn:task id="A13" name="Decorar cupcakes según pedido" />
    <bpmn:task id="A14" name="Empacar el pedido" />
    <bpmn:sendTask id="A15" name="Entregar pedido al cliente" />
    <bpmn:eventBasedGateway id="G5" name="" />
    <bpmn:intermediateCatchEvent id="E5" name="Reclamo recibido">
      <bpmn:messageEventDefinition id="MED_E5" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="E6" name="Transcurre 1 día sin reclamo">
      <bpmn:timerEventDefinition id="TED_E6">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P1D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="E7" name="Pedido cerrado" />
    <bpmn:task id="A16" name="Desechar defectuosos y enviarlos a calidad" />
    <bpmn:task id="A17" name="Recoger muestra e información del defecto" />
    <bpmn:sendTask id="A18" name="Producir y enviar media docena de compensación" />
    <bpmn:exclusiveGateway id="U4" name="" />
    <bpmn:task id="A19" name="Analizar causas de los defectos" />
    <bpmn:task id="A20" name="Determinar pérdidas (costos)" />
    <bpmn:sendTask id="A21" name="Enviar análisis a producción" />
    <bpmn:endEvent id="E8" name="Análisis entregado" />
    <bpmn:sequenceFlow id="F_E1_A1" sourceRef="E1" targetRef="A1" />
    <bpmn:sequenceFlow id="F_A1_A2" sourceRef="A1" targetRef="A2" />
    <bpmn:sequenceFlow id="F_A2_G1" sourceRef="A2" targetRef="G1" />
    <bpmn:sequenceFlow id="F_G1_Si" name="Sí" sourceRef="G1" targetRef="A3">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">primerLote == true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_G1_No" name="No" sourceRef="G1" targetRef="U1" />
    <bpmn:sequenceFlow id="F_A3_U1" sourceRef="A3" targetRef="U1" />
    <bpmn:sequenceFlow id="F_U1_A4" sourceRef="U1" targetRef="A4" />
    <bpmn:sequenceFlow id="F_A4_U2" sourceRef="A4" targetRef="U2" />
    <bpmn:sequenceFlow id="F_U2_A5" sourceRef="U2" targetRef="A5" />
    <bpmn:sequenceFlow id="F_A5_G2" sourceRef="A5" targetRef="G2" />
    <bpmn:sequenceFlow id="F_G2_Si" name="Sí" sourceRef="G2" targetRef="A6">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">humedadCorrecta == true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_G2_No" name="No" sourceRef="G2" targetRef="E2" />
    <bpmn:sequenceFlow id="F_E2_U2" sourceRef="E2" targetRef="U2" />
    <bpmn:sequenceFlow id="F_A6_G3" sourceRef="A6" targetRef="G3" />
    <bpmn:sequenceFlow id="F_G3_Si" name="Sí" sourceRef="G3" targetRef="A7">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">toppingsEspeciales == true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_G3_No" name="No" sourceRef="G3" targetRef="U3" />
    <bpmn:sequenceFlow id="F_A7_U3" sourceRef="A7" targetRef="U3" />
    <bpmn:sequenceFlow id="F_U3_A8" sourceRef="U3" targetRef="A8" />
    <bpmn:sequenceFlow id="F_A8_A9" sourceRef="A8" targetRef="A9" />
    <bpmn:sequenceFlow id="F_A9_E3" sourceRef="A9" targetRef="E3" />
    <bpmn:sequenceFlow id="F_E3_A10" sourceRef="E3" targetRef="A10" />
    <bpmn:sequenceFlow id="F_A10_E4" sourceRef="A10" targetRef="E4" />
    <bpmn:sequenceFlow id="F_E4_A11" sourceRef="E4" targetRef="A11" />
    <bpmn:sequenceFlow id="F_A11_A12" sourceRef="A11" targetRef="A12" />
    <bpmn:sequenceFlow id="F_A12_G4" sourceRef="A12" targetRef="G4" />
    <bpmn:sequenceFlow id="F_G4_Conformes" name="Conformes" sourceRef="G4" targetRef="A13" />
    <bpmn:sequenceFlow id="F_G4_Defectuosos" name="Defectuosos" sourceRef="G4" targetRef="A16">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">hayDefectuosos == true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_A13_A14" sourceRef="A13" targetRef="A14" />
    <bpmn:sequenceFlow id="F_A14_A15" sourceRef="A14" targetRef="A15" />
    <bpmn:sequenceFlow id="F_A15_G5" sourceRef="A15" targetRef="G5" />
    <bpmn:sequenceFlow id="F_G5_E5" sourceRef="G5" targetRef="E5" />
    <bpmn:sequenceFlow id="F_G5_E6" sourceRef="G5" targetRef="E6" />
    <bpmn:sequenceFlow id="F_E6_E7" sourceRef="E6" targetRef="E7" />
    <bpmn:sequenceFlow id="F_E5_A17" sourceRef="E5" targetRef="A17" />
    <bpmn:sequenceFlow id="F_A17_A18" sourceRef="A17" targetRef="A18" />
    <bpmn:sequenceFlow id="F_A18_U4" sourceRef="A18" targetRef="U4" />
    <bpmn:sequenceFlow id="F_A16_U4" sourceRef="A16" targetRef="U4" />
    <bpmn:sequenceFlow id="F_U4_A19" sourceRef="U4" targetRef="A19" />
    <bpmn:sequenceFlow id="F_A19_A20" sourceRef="A19" targetRef="A20" />
    <bpmn:sequenceFlow id="F_A20_A21" sourceRef="A20" targetRef="A21" />
    <bpmn:sequenceFlow id="F_A21_E8" sourceRef="A21" targetRef="E8" />
  </bpmn:process>
